{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private profile and preferences for an authenticated ALSTORE customer, isolated strictly to the account owner.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Authentication UID matching document ID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "User display name from Google or Apple Sign-In."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 200,
          "description": "Verified email address of the user."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Avatar image URL if available."
        },
        "whatsapp": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^[0-9+\\-\\s]*$",
          "description": "Saved WhatsApp number for quick checkout autofill."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user profile was first created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user profile was last updated."
        }
      },
      "required": ["uid", "displayName", "email", "photoURL", "whatsapp", "createdAt", "updatedAt"]
    },
    "SavedGameAccount": {
      "title": "SavedGameAccount",
      "description": "Saved favorite game User ID and Zone/Server ID for fast checkout autofill.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the owning user."
        },
        "gameId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Catalog game slug ID."
        },
        "gameName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Human-readable game title."
        },
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Game User ID or Riot ID."
        },
        "zoneId": {
          "type": "string",
          "maxLength": 32,
          "description": "Optional Zone ID or Server name."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when account was saved."
        }
      },
      "required": ["ownerUid", "gameId", "gameName", "accountId", "zoneId", "updatedAt"]
    },
    "TopUpOrder": {
      "title": "TopUpOrder",
      "description": "Customer top-up invoice and payment state owned by an authenticated user.",
      "type": "object",
      "properties": {
        "invoiceId": {
          "type": "string",
          "minLength": 6,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique ALSTORE invoice code (e.g. ALS-2026XXXX)."
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the buyer who created this order."
        },
        "gameId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Game slug identifier."
        },
        "gameName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Game display name."
        },
        "itemName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Top-up denomination name."
        },
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Target game account User ID."
        },
        "zoneId": {
          "type": "string",
          "maxLength": 32,
          "description": "Target game Zone/Server ID."
        },
        "whatsapp": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20,
          "pattern": "^[0-9+\\-\\s]+$",
          "description": "Buyer WhatsApp number for invoice delivery."
        },
        "paymentMethodId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Selected payment method code."
        },
        "paymentMethodName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Selected payment method label."
        },
        "basePrice": {
          "type": "number",
          "description": "Item promo price in IDR."
        },
        "adminFee": {
          "type": "number",
          "description": "Payment gateway/method fee in IDR."
        },
        "uniqueCode": {
          "type": "number",
          "description": "Bank transfer unique verification digits."
        },
        "totalAmount": {
          "type": "number",
          "description": "Final payable amount in IDR."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "waiting_verification", "completed", "expired"],
          "description": "Current lifecycle status of the order."
        },
        "proofFileName": {
          "type": "string",
          "maxLength": 160,
          "description": "Filename of uploaded transfer proof receipt (metadata only)."
        },
        "expiresAtMs": {
          "type": "number",
          "description": "Epoch milliseconds when the 15-minute payment window expires."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of order creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": [
        "invoiceId",
        "ownerUid",
        "gameId",
        "gameName",
        "itemName",
        "accountId",
        "zoneId",
        "whatsapp",
        "paymentMethodId",
        "paymentMethodName",
        "basePrice",
        "adminFee",
        "uniqueCode",
        "totalAmount",
        "status",
        "proofFileName",
        "expiresAtMs",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private customer profile documents keyed by Firebase Auth UID."
    },
    "/users/{userId}/savedAccounts/{gameId}": {
      "schema": { "$ref": "#/entities/SavedGameAccount" },
      "description": "Per-game saved account IDs owned by the parent user."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/TopUpOrder" },
      "description": "Authenticated customer top-up orders keyed by unique invoiceId."
    }
  }
}
